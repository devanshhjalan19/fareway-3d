# Where the PartyKit multiplayer room server lives.
#
# Local dev: leave unset — the client defaults to 127.0.0.1:1999, which matches
#   `npm run party:dev`.
# Production (Netlify): set this to your deployed PartyKit host, e.g.
#   VITE_PARTYKIT_HOST=rickshaw-racing.YOUR-USERNAME.partykit.dev
VITE_PARTYKIT_HOST=
